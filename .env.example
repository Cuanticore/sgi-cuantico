PORT=3004
DEV_MODE=false
PUBLIC_URL=https://sig.cuantico.com
AZURE_REDIRECT_URI=https://your-domain/api/auth/callback/azure-ad

# ─── NextAuth ────────────────────────────────────────────────────────────────
NEXTAUTH_URL=https://your-domain
NEXTAUTH_SECRET=your-nextauth-secret

# ─── Azure AD (autenticación) ─────────────────────────────────────────────────
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=

# ─── SharePoint / Microsoft Graph ─────────────────────────────────────────────
SHAREPOINT_TENANT_ID=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=

# El mismo app credential se usa para sincronizar las PERSONAS del SIG desde Microsoft
# Graph (permiso de aplicación User.Read.All). Sin estas tres variables, la sincronización
# no corre y lo dice; nunca inventa un listado.

# ─── Motor de tareas del SIG ───────────────────────────────────────────────────
# Sin variables: la generación y los cierres usan la zona America/Bogota fija.
# Las notificaciones (resumen semanal y mensual) llegan en A4.

SHAREPOINT_SITE_URL=yourorg.sharepoint.com
SHAREPOINT_SITE_NAME=YourSite

# Rutas a los archivos Excel en SharePoint
SHAREPOINT_INDICATORS_PATH=
SHAREPOINT_INDICATORS_FILE=
SHAREPOINT_INDICATORS_PATH_2025=
SHAREPOINT_INDICATORS_FILE_2025=

# URLs web de la Matriz de Indicadores (para abrir en SharePoint)
SHAREPOINT_MATRIX_URL_2026=
SHAREPOINT_MATRIX_URL_2025=

# ─── Modo desarrollo (archivos locales) ───────────────────────────────────────
LOCAL_INDICATORS_FILE_2026=
LOCAL_INDICATORS_FILE_2025=

# ─── SMTP — notificaciones de menciones (evidencia) ────────────────────────────
# Credenciales de la cuenta de correo saliente (MailerSend en cuantico.com).
# NUNCA se versionan: van en .env.
SMTP_HOST=smtp.mailersend.net
SMTP_PORT=587
# false = STARTTLS (el estándar de MailerSend); true = SSL implícito (465).
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=

# ─── Anexos de evidencia (sgi) ──────────────────────────────────────────────────
# DECISIÓN (27/08/2026): los anexos se guardan EN LA BASE DE DATOS (BYTEA, tabla
# evidencia_archivo 1:1). No se requiere bucket: la metadata y los bytes viven juntos
# y la baja es lógica con retención. `SGI_ARCHIVOS_PROVEEDOR=local` cambia a disco
# fuera de la raíz web (solo dev).
SGI_ARCHIVOS_PROVEEDOR=postgres
SGI_ARCHIVOS_DIR=var/sgsi-anexos
# Secreto de las rutas firmadas (TTL corto). Si no se define, cae en NEXTAUTH_SECRET.
SGI_RUTAS_SECRETO=
# Límites de anexos (MB) para la pantalla de parámetros: anexo_tamano_max_mb /
# anexo_total_max_mb.
# Antivirus: comando que reciba el archivo en {archivo} y devuelva 0 si está limpio.
# Ejemplo (ClamAV): "clamscan --quiet --no-summary {archivo}". Sin ella los anexos
# quedan protegidos por lista blanca + verificación de contenido, y la bitácora lo
# registra.
SGI_ANTIVIRUS_CMD=
#
# Reservadas para el futuro adaptador S3 (si la decisión cambia):
# SGI_S3_ENDPOINT=
# SGI_S3_REGION=
# SGI_S3_BUCKET=
# SGI_S3_ACCESS_KEY=
# SGI_S3_SECRET_KEY=
# SGI_RUTAS_FIRMADAS_TTL=900
