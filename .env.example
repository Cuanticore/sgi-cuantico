PORT=3004
DEV_MODE=false
PUBLIC_URL=https://sig.cuantico.com
AZURE_REDIRECT_URI=https://your-domain/api/auth/callback/azure-ad

# ─── NextAuth ────────────────────────────────────────────────────────────────
NEXTAUTH_URL=https://your-domain
NEXTAUTH_SECRET=your-nextauth-secret

# ─── Azure AD (autenticación) ─────────────────────────────────────────────────
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=

# ─── Rol simulado: RETIRADO el 08/09/2026 ─────────────────────────────────────
#
# `SGI_ROL_DEV` otorgaba el rol en desarrollo sin mirar ningun grupo del Directorio.
# Se retiro porque hacia que el entorno local NO ejercitara el camino real: el acceso
# funcionaba en la maquina de quien programa y fallaba en produccion, que es el peor
# resultado posible de una herramienta de pruebas — oculta justo el defecto a encontrar.
#
# Para ver que trae tu token y por que tenes el acceso que tenes: /mi-sig/diagnostico
# ─── SharePoint / Microsoft Graph ─────────────────────────────────────────────
SHAREPOINT_TENANT_ID=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=

# El mismo app credential se usa para sincronizar las PERSONAS del SIG desde Microsoft
# Graph (permiso de aplicación User.Read.All). Sin estas tres variables, la sincronización
# no corre y lo dice; nunca inventa un listado.

# ─── Microsoft Sentinel (espejo de incidentes de seguridad) ───────────────────
# Service principal PROPIO, distinto de AZURE_AD_* y de SHAREPOINT_*: RBAC distinto.
# AZURE_AD_* es el registro del inicio de sesión de TODA la aplicación — apuntar acá la
# sincronización obligaría a darle Log Analytics Reader al app registration por el que
# entra toda la empresa. SHAREPOINT_* es peor: ese service principal tiene permisos de
# ESCRITURA en Graph (deshabilita cuentas, sube archivos). Un secreto de SENTINEL_* filtrado
# solo puede leer incidentes de un workspace: menor privilegio, a propósito.
#
# Rol requerido en el portal de Azure: Log Analytics Reader sobre el workspace
# (control de acceso/IAM del workspace — NO un permiso de aplicación en el registro).
SENTINEL_TENANT_ID=
SENTINEL_CLIENT_ID=
SENTINEL_CLIENT_SECRET=
SENTINEL_WORKSPACE_ID=

# Ventana de tiempo (ISO-8601) de la sincronización, vía el `timespan` de la consulta a
# Log Analytics — nunca un `ago()` en el KQL (dos ventanas compitiendo pierden filas en
# silencio). Sin definir, cae en 'P30D': medido contra el workspace real, cubre los 19
# incidentes actuales con margen (la tabla retiene 730 días). Una primera carga contra un
# tenant con más historial podría necesitar más.
# SENTINEL_TIMESPAN_SINCRONIZACION=P30D

# ─── Motor de tareas del SIG ───────────────────────────────────────────────────
# Sin variables: la generación y los cierres usan la zona America/Bogota fija.
# Las notificaciones (resumen semanal y mensual) llegan en A4.

# ─── Notificaciones del SIG ───────────────────────────────────────────────────
# Hora del disparo (America/Bogota) y los días del resumen semanal (1=lunes) y
# mensual (1=primer día del mes; si cae fin de semana, se envía el lunes siguiente).
# SGI_CORREO_LIDER_SIG es el correo que recibe el mensual con todas las áreas.
SGI_CORREO_HORA=7
SGI_CORREO_DIA_SEMANAL=1
SGI_CORREO_DIA_MENSUAL=1
# SGI_CORREO_LIDER_SIG=

SHAREPOINT_SITE_URL=yourorg.sharepoint.com
SHAREPOINT_SITE_NAME=YourSite

# Rutas a los archivos Excel en SharePoint
SHAREPOINT_INDICATORS_PATH=
SHAREPOINT_INDICATORS_FILE=
SHAREPOINT_INDICATORS_PATH_2025=
SHAREPOINT_INDICATORS_FILE_2025=

# URLs web de la Matriz de Indicadores (para abrir en SharePoint)
SHAREPOINT_MATRIX_URL_2026=
SHAREPOINT_MATRIX_URL_2025=

# ─── Modo desarrollo (archivos locales) ───────────────────────────────────────
LOCAL_INDICATORS_FILE_2026=
LOCAL_INDICATORS_FILE_2025=

# ─── SMTP — notificaciones de menciones (evidencia) ────────────────────────────
# Credenciales de la cuenta de correo saliente (MailerSend en cuantico.com).
# NUNCA se versionan: van en .env.
SMTP_HOST=smtp.mailersend.net
SMTP_PORT=587
# false = STARTTLS (el estándar de MailerSend); true = SSL implícito (465).
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=

# ─── Player SCORM 2004 (REQ-SIG-14) ────────────────────────────────────────────
#
# SIN ESTAS DOS VARIABLES NINGUN CURSO ABRE. `abrirIntento` se niega y lo dice: correr el
# contenido de un curso en el origen de la aplicacion le daria al JavaScript de un tercero
# la sesion de quien lo abre, asi que no hay modo degradado.
#
# SCORM_ORIGEN_CONTENIDO es un SUBDOMINIO APARTE, no una ruta. Ahi se sirven el runner y los
# archivos del paquete, y nada mas — la plantilla de nginx esta en
# `deploy/origen-cursos.nginx.example` y devuelve 404 a todo lo que no sea /scorm/.
# Necesita su propio registro DNS y su propio certificado.
#
# SCORM_ORIGEN_APP es el origen de la aplicacion, y el runner lo exige para saber de quien
# acepta `postMessage`. Un comodin ahi le entregaria la API de SCORM a cualquier pagina que
# logre abrir el runner en un iframe.
SCORM_ORIGEN_CONTENIDO=https://cursos.sig.cuantico.com
SCORM_ORIGEN_APP=https://sig.cuantico.com
# Techo del .zip que se acepta al subir un paquete. Se valida ANTES de descomprimir.
SCORM_TAMANO_MAX_MB=200

# ─── Anexos de evidencia (sgi) ──────────────────────────────────────────────────
# DECISIÓN (27/08/2026): los anexos se guardan EN LA BASE DE DATOS (BYTEA, tabla
# evidencia_archivo 1:1). No se requiere bucket: la metadata y los bytes viven juntos
# y la baja es lógica con retención. `SGI_ARCHIVOS_PROVEEDOR=local` cambia a disco
# fuera de la raíz web (solo dev).
SGI_ARCHIVOS_PROVEEDOR=postgres
SGI_ARCHIVOS_DIR=var/sgsi-anexos
# Secreto de las rutas firmadas (TTL corto). Si no se define, cae en NEXTAUTH_SECRET.
#
# OBLIGATORIO EN PRODUCCION. Tambien firma los tokens del player SCORM, y si no hay ninguno
# de los tres —SGI_RUTAS_SECRETO, AUTH_SECRET, NEXTAUTH_SECRET— la aplicacion FALLA al abrir
# un curso en vez de caer a un valor de reserva: el de reserva esta escrito en el repositorio
# y firmar con el equivale a no firmar.
SGI_RUTAS_SECRETO=
# Límites de anexos (MB) para la pantalla de parámetros: anexo_tamano_max_mb /
# anexo_total_max_mb.
# Antivirus: comando que reciba el archivo en {archivo} y devuelva 0 si está limpio.
# Ejemplo (ClamAV): "clamscan --quiet --no-summary {archivo}". Sin ella los anexos
# quedan protegidos por lista blanca + verificación de contenido, y la bitácora lo
# registra.
SGI_ANTIVIRUS_CMD=
#
# Reservadas para el futuro adaptador S3 (si la decisión cambia):
# SGI_S3_ENDPOINT=
# SGI_S3_REGION=
# SGI_S3_BUCKET=
# SGI_S3_ACCESS_KEY=
# SGI_S3_SECRET_KEY=
# SGI_RUTAS_FIRMADAS_TTL=900
