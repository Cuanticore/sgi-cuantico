# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env
.env.*
.env*.local
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# superpowers
.superpowers/

# temp / debug scripts
tmp_verify*.mjs
read-excel-*.js
auth-test.ts

# claude local settings
.claude/

# Skill registry cache — tooling metadata, machine-local
/.atl/

# Bounded-review artifacts — produced per review, never part of the change
/.review/

# secretos que el patron .env.* no atrapa: el nombre lleva un espacio, no un punto
.env prod.env

# llaves privadas: *.pem ya estaba, *.ppk (PuTTY) no
*.ppk

# Volcados de la base (scripts/respaldo.mjs). Nunca se versionan: son datos reales de
# la organizacion, y un respaldo dentro del repositorio no es un respaldo.
var/respaldos/

# Libros de Excel del SGSI (FOR-SIG-*, consolidado de activos). Traen el inventario real
# de la organizacion con nombres de personas y descripciones de sistemas: son datos, no
# codigo, y no se versionan. Se cargan por la pantalla de carga, no por el repositorio.
*.xlsx
*.xls
*.xlsm

# Volcados del parte de importacion (Errores.txt y similares). Llevan nombres de activos
# reales de la organizacion: son datos de trabajo, no codigo.
Errores.txt

# Salida de Playwright. Las trazas y capturas de un recorrido fallido llevan la pantalla
# entera: codigos de activo, IP, nombres de servidores. Es el mapa que el propio layout de
# /tecnologia se niega a mostrar sin el grupo del Directorio, y no entra al repositorio.
/test-results/
/playwright-report/
/blob-report/
/.playwright/

# El tunel a la base. Lleva el id de la instancia EC2 y la IP interna: son descripciones de
# sistemas reales, lo mismo que mantiene fuera del repositorio a los libros del SGSI. Su
# gemelo en PowerShell vive en ~/.claude/cuantico/tunel.ps1, y por la misma razon.
/tunel.bat

# El supervisor del tunel (16/09/2026). Misma razon que la linea de arriba: adentro estan el
# id de la instancia y la IP interna de la base. Sonda el handshake de Postgres en vez de
# mirar si el puerto escucha, porque el fallo que se vio ese dia fue un puerto escuchando
# con el reenvio muerto.
/tunel-bd.bat
/tunel-bd.ps1
