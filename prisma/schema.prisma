// prisma/schema.prisma
//
// SGSI domain: MAGERIT v3.0 asset and risk analysis + ISO/IEC 27001:2022 Annex A
// control maturity. Built from, in authority order:
//
//   1. docs/handoff_v2/requisitos/MET-SIG-01 Metodologia v3.docx   the approved method
//   2. docs/handoff_v2/requisitos/REQ-SIG-01-requerimiento.txt     the tool requirement
//   3. docs/handoff_v2/requisitos/MATRIZ MAGERIT ... v2.xlsx       the formula layer
//   4. docs/handoff_v2/requisitos/SPEC-herramienta-riesgos-v2.md   field names and enums
//
// Domain names are Spanish because the method, the workbook and the auditors are.
//
// TWO RULES THIS SCHEMA ENFORCES STRUCTURALLY
//
// 1. No residual impact exists. Control efficacy reduces FREQUENCY, never impact.
//    Controls that limit damage lower the THREAT's degradation instead, so there is
//    one judgement per row and not two (MET-SIG-01 section 7.4). There is no column
//    for it anywhere, and there must never be one.
//
// 2. Levels, bands, zones, counts and matrices are classified at READ time. The four
//    derived decimals on Riesgo are the only computed values that persist, they have
//    exactly one writer, and every calculation is frozen in RiesgoCalculo. Precooked
//    matrices are what produced contradictory figures in v1.
//
// Operational rows reference the LEVEL, never the number: every valuation, degradation,
// frequency and maturity is a foreign key into its scale table. That is what lets the
// organisation return to five dimensions or a 0-10 scale without a deployment
// (REQ-SIG-01 line 129).
//
// Single tenant by design. No organizationId: this instance serves Cuantico only.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// Scales and thresholds — parametrizable, never constants in code
// ============================================================================

/// MAGERIT defines five security dimensions. Cuantico declares a deviation and works
/// with the first three (MET-SIG-01 section 5.2). A and T are modelled but inactive so
/// the decision is reversible without a migration.
model Dimension {
  id     Int     @id @default(autoincrement())
  codigo String  @unique @db.Char(1) // D, I, C, A, T
  nombre String
  activa Boolean @default(true)
  orden  Int

  valoresActivo      ActivoValor[]
  degradacionAmenaza AmenazaDegradacion[]
  degradacionRiesgo  RiesgoDegradacion[]

  @@map("dimension")
}

/// Asset value in one dimension. Declared deviation: 0-5 rather than MAGERIT's 0-10,
/// with impact, risk and zone thresholds rescaled in the same proportion.
model EscalaValor {
  id       Int    @id @default(autoincrement())
  etiqueta String @unique // "5 — Muy Alto" … "0 — Irrelevante"
  valor    Int    @unique // 5..0
  orden    Int

  valoresActivo ActivoValor[]

  @@map("escala_valor")
}

/// Fraction of the asset's value a threat destroys in one dimension.
model EscalaDegradacion {
  id      Int     @id @default(autoincrement())
  nombre  String  @unique // Muy alta, Alta, Media, Baja, Muy baja, No aplica
  factor  Decimal @db.Decimal(4, 2) // 1.00, 0.80, 0.50, 0.20, 0.05, 0.00
  lectura String?
  orden   Int     @unique

  degradacionAmenaza AmenazaDegradacion[]
  degradacionRiesgo  RiesgoDegradacion[]

  @@map("escala_degradacion")
}

/// Expected annual rate of occurrence.
model EscalaFrecuencia {
  id       Int     @id @default(autoincrement())
  nombre   String  @unique // "Muy alta — ocurre a diario" …
  vecesAno Decimal @map("veces_ano") @db.Decimal(8, 4) // 100, 10, 1, 0.1, 0.01
  orden    Int     @unique

  amenazas Amenaza[]
  riesgos  Riesgo[]

  @@map("escala_frecuencia")
}

/// CMM maturity to efficacy, per PILAR (CCN-CERT). The big jump is L2 to L3, from 50%
/// to 90%: what changes risk is moving from "everyone does it their own way" to
/// "there is a defined process" (MET-SIG-01 section 8).
model EscalaMadurez {
  id       Int     @id @default(autoincrement())
  nivel    Int     @unique // 0..5
  nombre   String // Inexistente, Inicial / ad hoc, …
  eficacia Decimal @db.Decimal(4, 3) // 0.000, 0.100, 0.500, 0.900, 0.950, 1.000
  lectura  String?

  controlesBase     Control[]    @relation("ControlLineaBase")
  controlesActual   Control[]    @relation("ControlActual")
  controlesObjetivo Control[]    @relation("ControlObjetivo")
  riesgos           Riesgo[]
  accionesAlcanzada AccionPlan[] @relation("AccionMadurezAlcanzada")
  accionesObjetivo  AccionPlan[] @relation("AccionMadurezObjetivo")

  @@map("escala_madurez")
}

/// Band boundaries for accumulated impact. Read-time classification only.
model UmbralImpacto {
  id     Int     @id @default(autoincrement())
  nombre String  @unique // Muy alto, Alto, Medio, Bajo, Despreciable
  desde  Decimal @db.Decimal(9, 4)
  hasta  Decimal @db.Decimal(9, 4)
  orden  Int     @unique

  @@map("umbral_impacto")
}

/// Band boundaries for potential and residual risk. Read-time classification only.
model UmbralRiesgo {
  id     Int     @id @default(autoincrement())
  nombre String  @unique // Crítico, Alto, Medio, Bajo
  desde  Decimal @db.Decimal(12, 4)
  hasta  Decimal @db.Decimal(12, 4)
  orden  Int     @unique

  criterio CriterioAceptacion?

  @@map("umbral_riesgo")
}

/// Weight of a control within the set that mitigates a threat (MET-SIG-01 section 7.4).
/// The cap is the essential part of the rule: secondary controls accompany the
/// principal one, they do not replace it.
model RelevanciaControl {
  id          Int     @id @default(autoincrement())
  nombre      String  @unique // Principal, Complementario, De apoyo
  peso        Int // 3, 2, 1
  esPrincipal Boolean @default(false) @map("es_principal")
  criterio    String
  orden       Int

  controlesAmenaza ControlAmenaza[]

  @@map("relevancia_control")
}

/// What the Committee decides for each risk band, and within what deadline.
/// MET-SIG-01 marks the deadlines as pending ratification.
model CriterioAceptacion {
  id             Int     @id @default(autoincrement())
  umbralRiesgoId Int     @unique @map("umbral_riesgo_id")
  decision       String
  plazoPlan      String  @map("plazo_plan")
  plazoEjecucion String  @map("plazo_ejecucion")
  aprueba        String
  ratificado     Boolean @default(false)

  umbralRiesgo UmbralRiesgo @relation(fields: [umbralRiesgoId], references: [id])

  @@map("criterio_aceptacion")
}

/// Single key/value store for tunables: umbral_valoracion (4), delta_techo_eficacia
/// (0.05), metrica_indice, periodicidades, zona_horaria, borrado_fisico (false).
model Parametro {
  clave       String   @id
  valor       String
  descripcion String?
  actualizado DateTime @updatedAt

  @@map("parametro")
}

// ============================================================================
// Organisation — closed lists. Free text degraded in production elsewhere:
// "Líder del SIG" against "Lider del SIG", and person names in a role column.
// ============================================================================

/// Process or responsible area. Shared with the SGC indicators domain, which groups by
/// the same processes: two parallel lists drift apart. `prefijo` feeds the asset code.
model Area {
  id           Int     @id @default(autoincrement())
  prefijo      String  @unique @db.Char(3) // EST, COM, PRY, SOP, TAL, LEG, TEC, SIG, FIN, TRA
  nombre       String  @unique
  liderCargoId Int?    @map("lider_cargo_id")
  activa       Boolean @default(true)
  orden        Int

  liderCargo CargoResponsable? @relation("AreaLider", fields: [liderCargoId], references: [id])
  activos    Activo[]
  contadores ContadorCodigo[]
  personas   Persona[]
  obligacionesAlcance Obligacion[]
  hallazgos  Hallazgo[] @relation("HallazgoArea")

  @@map("area")
}

model CargoResponsable {
  id     Int     @id @default(autoincrement())
  nombre String  @unique
  activo Boolean @default(true)
  orden  Int

  /// Which of the asset sheet's two role lists this position appears in.
  ///
  /// REQ-SIG-01:212 has ONE list feed owner, custodian and treatment responsible, and the
  /// client's own workbook agrees — `LstCargo` is a single named range with no
  /// LstPropietario or LstCustodio beside it. The client then asked for the two lists to be
  /// separate, and these flags are how: one row per POSITION, two independently curated
  /// views of it.
  ///
  /// Two tables would have been the other way, and worse. `CargoResponsable` is pointed at
  /// by SEVEN foreign keys — area lead, control responsible, asset owner, asset custodian,
  /// risk responsible, and the action plan's responsible and approver — so splitting it
  /// means migrating every one of them, and
  /// the day somebody renames a position in one table and not the other there are two
  /// truths about the same position. That is how «Líder del SIG» and «Lider del SIG» ended
  /// up coexisting in production.
  ///
  /// Both default TRUE so the migration changes nothing on the screen: every position stays
  /// offered in both lists until somebody curates them. The application cannot know which
  /// positions may own an asset and which may safeguard it — that is the organisation's
  /// call, and now it has the control to make it.
  esPropietario Boolean @default(true) @map("es_propietario")
  esCustodio    Boolean @default(true) @map("es_custodio")

  areasLideradas      Area[]       @relation("AreaLider")
  activosPropietario  Activo[]     @relation("ActivoPropietario")
  activosCustodio     Activo[]     @relation("ActivoCustodio")
  controles           Control[]
  riesgos             Riesgo[]
  accionesResponsable AccionPlan[] @relation("AccionResponsable")
  accionesAprueba     AccionPlan[] @relation("AccionAprueba")
  personas            Persona[]
  obligacionesAlcance Obligacion[]

  @@map("cargo_responsable")
}

/// Editable catalogue. The protected value "No aplica" cannot be deleted; the flag
/// lives on the row rather than being keyed off the name.
model Proveedor {
  id        Int     @id @default(autoincrement())
  nombre    String  @unique
  protegido Boolean @default(false)
  activo    Boolean @default(true)

  activos Activo[]

  @@map("proveedor")
}

model Ubicacion {
  id        Int     @id @default(autoincrement())
  nombre    String  @unique
  protegido Boolean @default(false)
  activo    Boolean @default(true)

  activos Activo[]

  @@map("ubicacion")
}

model Entorno {
  id        Int     @id @default(autoincrement())
  nombre    String  @unique
  protegido Boolean @default(false)
  activo    Boolean @default(true)

  activos Activo[]

  @@map("entorno")
}

// ============================================================================
// MAGERIT catalogue
// ============================================================================

model TipoMagerit {
  id          Int     @id @default(autoincrement())
  codigo      String  @unique // [D], [SW], [HW], [COM], [K], [S], [Media], [AUX], [L], [P]
  nombre      String
  abreviatura String  @unique @db.Char(3) // DAT, APP, EQU, RED, CLA, SER, SOP, AUX, INS, PER
  esNormativo Boolean @default(true) @map("es_normativo")
  activo      Boolean @default(true)
  orden       Int

  subtipos   SubtipoMagerit[]
  activos    Activo[]
  amenazas   AmenazaTipo[]
  contadores ContadorCodigo[]

  @@map("tipo_magerit")
}

model SubtipoMagerit {
  id          Int     @id @default(autoincrement())
  tipoId      Int     @map("tipo_id")
  codigo      String // [files], [backup], …
  nombre      String
  esNormativo Boolean @default(true) @map("es_normativo")
  activo      Boolean @default(true)

  tipo    TipoMagerit @relation(fields: [tipoId], references: [id])
  activos Activo[]

  @@unique([tipoId, codigo])
  @@map("subtipo_magerit")
}

/// 57 threats. Codes carry a LITERAL asterisk (N.*, I.* are real catalogue entries,
/// not placeholders), which is why lookups sanitise it to a dash.
model Amenaza {
  id             Int     @id @default(autoincrement())
  codigo         String  @unique // E.1, A.30, I.8, N.*
  nombre         String
  grupo          String // [N] Desastres naturales, [I] Industrial, [E] Errores…, [A] Ataques…
  frecuenciaId   Int     @map("frecuencia_id")
  notaAplicacion String? @map("nota_aplicacion")
  activa         Boolean @default(true)

  frecuencia  EscalaFrecuencia     @relation(fields: [frecuenciaId], references: [id])
  tipos       AmenazaTipo[]
  degradacion AmenazaDegradacion[]
  controles   ControlAmenaza[]
  riesgos     Riesgo[]

  @@map("amenaza")
}

/// Pre-classification that GENERATES the risks: a risk is the cartesian product of the
/// asset by the threats applicable to its type. Asset CATEGORY is deliberately absent
/// from the key — including it made the same pair exist several times and a control
/// counted twice in its own average.
model AmenazaTipo {
  amenazaId Int     @map("amenaza_id")
  tipoId    Int     @map("tipo_id")
  aplica    Boolean @default(true)

  amenaza Amenaza     @relation(fields: [amenazaId], references: [id])
  tipo    TipoMagerit @relation(fields: [tipoId], references: [id])

  @@id([amenazaId, tipoId])
  @@map("amenaza_tipo")
}

/// Degradation is an attribute of the THREAT, not of the individual risk. Controls that
/// limit damage are reflected here (MET-SIG-01 section 7.4).
model AmenazaDegradacion {
  amenazaId       Int     @map("amenaza_id")
  dimensionId     Int     @map("dimension_id")
  degradacionId   Int     @map("degradacion_id")
  /// Records the declared deviation: E.3, A.3, A.5 and A.13 are reassigned from
  /// Autenticidad or Trazabilidad to Integridad so their risk does not vanish.
  reasignadaDesde String? @map("reasignada_desde") @db.Char(1)

  amenaza     Amenaza           @relation(fields: [amenazaId], references: [id])
  dimension   Dimension         @relation(fields: [dimensionId], references: [id])
  degradacion EscalaDegradacion @relation(fields: [degradacionId], references: [id])

  @@id([amenazaId, dimensionId])
  @@map("amenaza_degradacion")
}

// ============================================================================
// ISO/IEC 27001:2022 Annex A
// ============================================================================

model DominioAnexoA {
  id     Int    @id @default(autoincrement())
  nombre String @unique // Organizacional, Personas, Físico, Tecnológico
  orden  Int

  controles Control[]

  @@map("dominio_anexo_a")
}

/// The 15 operational capabilities of ISO/IEC 27002:2022. The radar is built on these,
/// not on the four domains: four axes show nothing, fifteen give the resolution needed
/// to see where the imbalance is (MET-SIG-01 section 8.3).
model CapacidadOperativa {
  id          Int    @id @default(autoincrement())
  nombre      String @unique
  /// Narrow columns and radar axes cannot fit the full name.
  nombreCorto String @map("nombre_corto")
  orden       Int

  controles Control[]

  @@map("capacidad_operativa")
}

/// The 93 Annex A controls. Maturity levels are null exactly when the control does not
/// apply; a non-applicable control is excluded from every average, and letting a single
/// zero into a mean is the bug that constraint exists to prevent.
///
/// The application state is the three-state SOA declaration (ISO 27001 6.1.3 d):
/// a control is applicable when `soa != NO`, and NO/PARCIAL both carry a written
/// justification an auditor will review.
model Control {
  id             Int        @id @default(autoincrement())
  codigo         String     @unique // A.5.1 … A.8.34
  nombre         String
  dominioId      Int        @map("dominio_id")
  capacidadId    Int        @map("capacidad_id")
  soa            EstadoSoa  @default(SI)
  /// Written justification, mandatory when soa is PARCIAL (which part of the scope is
  /// covered and which is not) or NO (why the control is excluded).
  justificacionSoa  String?  @map("justificacion_soa")
  /// DEC-SIG-01 v2. The SoA document that this declaration belongs to, so every state
  /// answer reads against the version that sustains it (ISO 27001 6.1.3 d).
  soaDescripcion String?  @map("soa_descripcion")
  soaDocumento   String?  @map("soa_documento")
  soaVersion     String?  @map("soa_version")
  soaFecha       DateTime? @map("soa_fecha") @db.Date
  soaAprobadoPor String?  @map("soa_aprobado_por")
  /// True for the seven physical controls (A.7.1-4, A.7.6, A.7.11-12) declared applicable
  /// with the scope adapted to the remote operating model. It is what raises the
  /// DEC-SIG-01 §9 business alert: acquiring or renting own facilities forces an
  /// immediate review of domain A.7.
  soaAlcanceAdaptado Boolean @default(false) @map("soa_alcance_adaptado")
  /// Audit trail of the last SOA change: who and when. The full history lives in the
  /// bitácora; these two columns are the current state an auditor asks for first.
  soaActualizadoPor String?  @map("soa_actualizado_por")
  soaActualizadoEn  DateTime? @map("soa_actualizado_en")
  lineaBaseId    Int?      @map("linea_base_id")
  actualId       Int?      @map("actual_id")
  objetivoId     Int?      @map("objetivo_id")
  /// Evidence of the rating. The written justification of a non-applicable control now
  /// lives in `justificacionSoa`; this column holds the evidence of the maturity level
  /// when the control applies.
  evidencia      String
  responsableId  Int?      @map("responsable_id")
  fechaObjetivo  DateTime? @map("fecha_objetivo") @db.Date
  /// Present and unused for now: preventiva, disuasoria, deteccion, correctiva,
  /// recuperacion, concienciacion. Composition is not implemented.
  funcionControl String?   @map("funcion_control")

  dominio     DominioAnexoA      @relation(fields: [dominioId], references: [id])
  capacidad   CapacidadOperativa @relation(fields: [capacidadId], references: [id])
  lineaBase   EscalaMadurez?     @relation("ControlLineaBase", fields: [lineaBaseId], references: [id])
  actual      EscalaMadurez?     @relation("ControlActual", fields: [actualId], references: [id])
  objetivo    EscalaMadurez?     @relation("ControlObjetivo", fields: [objetivoId], references: [id])
  responsable CargoResponsable?  @relation(fields: [responsableId], references: [id])
  amenazas    ControlAmenaza[]
  evidencias  Evidencia[]
  acciones    AccionPlan[]

  @@map("control")
}

/// 272 pairs: which controls mitigate which threat.
///
/// They come from the AVERAGE formulas of the AX column of «Amenazas MAGERIT» in the MAGERIT
/// workbook, extracted by `prisma/extraer-pares.ts`; the `am` field of the ISO control file
/// carries the same mapping and the seed cross-checks the two.
///
/// `relevanciaId` used to be NOT NULL, on the reasoning that a nullable column is how the
/// reference implementation ended up applying one hardcoded value to 263 pairs and computing
/// the plain mean the methodology condemns. The reasoning was right about the risk and wrong
/// about the remedy — see the field's own comment below.
model ControlAmenaza {
  amenazaId Int @map("amenaza_id")
  controlId Int @map("control_id")
  /// NULLABLE, and that is the whole point.
  ///
  /// The PAIR is data the workbook already holds: the AX column of «Amenazas MAGERIT»
  /// averages an explicit list of control cells, and that list IS this mapping — 272 pairs
  /// over 57 threats. The RELEVANCE (Principal / Complementario / De apoyo, weights 3/2/1
  /// with the δ cap) is what MET-SIG-01 v3 §7.4 ADDS on top, to replace the workbook's
  /// plain average.
  ///
  /// It was NOT NULL first, and that made relevance a precondition for recording the pair
  /// at all: the table stayed empty, every threat read as "no controls mapped", efficacy
  /// came back null, and all 2256 residual risks rendered "sin calcular". A refinement had
  /// been turned into a blocker.
  ///
  /// Null means "aggregate this pair the way the workbook does": weight 1, no principal,
  /// hence a plain mean. Assigning relevance upgrades the threat to the v3 rule without
  /// touching anything else.
  relevanciaId Int? @map("relevancia_id")

  amenaza    Amenaza            @relation(fields: [amenazaId], references: [id])
  control    Control            @relation(fields: [controlId], references: [id])
  relevancia RelevanciaControl? @relation(fields: [relevanciaId], references: [id])

  @@id([amenazaId, controlId])
  @@map("control_amenaza")
}

/// Per Control, never per risk. Without evidence the level does not hold up to an
/// auditor (MET-SIG-01 section 8.4).
model Evidencia {
  id        Int           @id @default(autoincrement())
  /// Exactamente uno de `controlId`, `registroId` o `hallazgoId` está presente — lo
  /// impone el CHECK en la migración. Tres consumidores, un solo manejo de archivos.
  controlId  Int?  @map("control_id")
  registroId Int?  @map("registro_id")
  hallazgoId Int?  @map("hallazgo_id")
  tipo      TipoEvidencia
  texto     String
  /// The base evidence carried over from the control's own justification cannot be
  /// removed from the list.
  esBase    Boolean       @default(false) @map("es_base")
  orden     Int           @default(0)
  creadaEn  DateTime      @default(now()) @map("creada_en")
  creadaPor String?       @map("creada_por")
  /// Actual only for tipo ARCHIVO. Logical delete: the row survives with `activo=false`
  /// because the object belongs to the evidence of a certification audit, and a physical
  /// delete would be exactly the artifact the audit is supposed to find.
  activo        Boolean  @default(true)
  /// Object key in the annex storage (server-generated, never the original name) or the
  /// local file path when the S3 provider is not configured yet.
  archivoKey    String?  @map("archivo_key")
  archivoNombre String?  @map("archivo_nombre")
  archivoMime   String?  @map("archivo_mime")
  archivoTamano Int?     @map("archivo_tamano")
  archivoSha256 String?  @map("archivo_sha256")
  /// Re-uploading the same file name creates a new version and keeps the previous one;
  /// the history is consultable through the same list.
  archivoVersion Int    @default(1) @map("archivo_version")
  archivoVersionDe Int? @map("archivo_version_de")

  archivo EvidenciaArchivo?

  control Control? @relation(fields: [controlId], references: [id])

  @@map("evidencia")
}

/// Bytes de un anexo, 1:1 con su fila de evidencia (tipo ARCHIVO). Tabla separada a
/// propósito: los listados de la grilla y del panel nunca arrastran los blobs — solo la
/// ruta de descarga lee esta tabla.
///
/// Decisión (27/08/2026): los anexos viven EN LA BASE DE DATOS, no en un bucket
/// externo. La retención sigue siendo la misma: la baja es lógica (activo=false) y los
/// bytes permanecen — evidencia sosteniendo una auditoría de certificación.
model EvidenciaArchivo {
  id          Int      @id @default(autoincrement())
  evidenciaId Int      @unique @map("evidencia_id")
  bytes       Bytes
  creadaEn    DateTime @default(now()) @map("creada_en")

  evidencia Evidencia @relation(fields: [evidenciaId], references: [id])

  @@map("evidencia_archivo")
}

enum TipoEvidencia {
  ENLACE
  ARCHIVO
  NOTA

  @@map("tipo_evidencia")
}

// ============================================================================
// Assets
// ============================================================================

/// Ternary answers keep "not yet decided" distinguishable from "no", which matters for
/// a personal-data question under Ley 1581.
enum Ternario {
  SI
  NO
  POR_DEFINIR

  @@map("ternario")
}

/// SOA declaration state per ISO/IEC 27001:2022 clause 6.1.3 d. Three states, not a
/// boolean: PARCIAL is an applicable control whose scope coverage is partial — it counts
/// in every indicator, but it rarely sustains L4/L5 in an audit.
enum EstadoSoa {
  SI
  PARCIAL
  NO

  @@map("estado_soa")
}

model Activo {
  id             Int     @id @default(autoincrement())
  /// AAA-TTT-NNNN. System generated, immutable and never reused. Nullable only while
  /// an asset is being created.
  codigo         String? @unique @db.VarChar(12)
  /// The identifier the asset carried in the workbook (LCO-01, TEC-008, GH-023), kept
  /// so traceability with already issued documents is not lost.
  codigoHeredado String? @map("codigo_heredado") @db.VarChar(50)
  nombre         String
  descripcion    String?
  areaId         Int     @map("area_id")
  tipoId         Int     @map("tipo_id")
  subtipoId      Int     @map("subtipo_id")
  /// Nullable against the specification, on purpose: the workbook's "Propietario del
  /// activo" column is empty for all 234 assets and the custodian is missing on two.
  /// Requiring them here would mean inventing an owner for every asset in the
  /// migration. The application requires both when an asset is created.
  propietarioId  Int?    @map("propietario_id")
  custodioId     Int?    @map("custodio_id")
  ubicacionId    Int?    @map("ubicacion_id")
  entornoId      Int?    @map("entorno_id")
  proveedorId    Int?    @map("proveedor_id")
  superiorId     Int?    @map("superior_id")

  datosCliente     Ternario @default(POR_DEFINIR) @map("datos_cliente")
  datosPersonales  Ternario @default(POR_DEFINIR) @map("datos_personales")
  expuestoInternet Ternario @default(POR_DEFINIR) @map("expuesto_internet")

  cantidad Int       @default(1)
  activo   Boolean   @default(true)
  bajaEn   DateTime? @map("baja_en")
  creadoEn DateTime  @default(now()) @map("creado_en")

  area         Area             @relation(fields: [areaId], references: [id])
  tipo         TipoMagerit      @relation(fields: [tipoId], references: [id])
  subtipo      SubtipoMagerit   @relation(fields: [subtipoId], references: [id])
  propietario  CargoResponsable? @relation("ActivoPropietario", fields: [propietarioId], references: [id])
  custodio     CargoResponsable? @relation("ActivoCustodio", fields: [custodioId], references: [id])
  ubicacion    Ubicacion?       @relation(fields: [ubicacionId], references: [id])
  entorno      Entorno?         @relation(fields: [entornoId], references: [id])
  proveedor    Proveedor?       @relation(fields: [proveedorId], references: [id])
  superior     Activo?          @relation("ActivoJerarquia", fields: [superiorId], references: [id])
  dependientes Activo[]         @relation("ActivoJerarquia")
  valores      ActivoValor[]
  riesgos      Riesgo[]

  @@index([areaId])
  @@index([tipoId])
  @@map("activo")
}

/// The asset's value is the greatest of its per-dimension values: one critical
/// dimension is enough to make the asset critical. It is DERIVED, never captured.
model ActivoValor {
  activoId    Int @map("activo_id")
  dimensionId Int @map("dimension_id")
  valorId     Int @map("valor_id")

  activo    Activo      @relation(fields: [activoId], references: [id])
  dimension Dimension   @relation(fields: [dimensionId], references: [id])
  valor     EscalaValor @relation(fields: [valorId], references: [id])

  @@id([activoId, dimensionId])
  @@map("activo_valor")
}

/// The consecutive runs independently per (area, type). Codes are immutable and never
/// reused, and deletes are logical, so MAX()+1 would hand out a retired number: this
/// counter is incremented with an atomic upsert-and-return instead.
model ContadorCodigo {
  areaId      Int @map("area_id")
  tipoId      Int @map("tipo_id")
  ultimoValor Int @default(0) @map("ultimo_valor")

  area Area        @relation(fields: [areaId], references: [id])
  tipo TipoMagerit @relation(fields: [tipoId], references: [id])

  @@id([areaId, tipoId])
  @@map("contador_codigo")
}

// ============================================================================
// Risk
// ============================================================================

enum OrigenRiesgo {
  /// Produced by the cartesian product of the asset by its type's threats.
  GENERADO
  /// Added by hand as an exception outside the type's parameterisation.
  EXCEPCION

  @@map("origen_riesgo")
}

/// One row per (asset, threat).
///
/// The four decimals below are DERIVED. They persist because 2256 risks aggregated
/// server-side cannot be recomputed on every read, and because sorting, filtering and
/// paging need them indexable. They are safe only under three conditions, all of which
/// hold here: a single writer service, an input snapshot in RiesgoCalculo, and no
/// stored band, level, zone or count anywhere.
///
/// `madurezId` is a nullable OVERRIDE. Left null, efficacy comes from the threat's
/// aggregated control efficacy. Two independent levers on the same number is exactly
/// the contradictory-figures failure.
///
/// There is no residual impact column, and there must never be one.
model Riesgo {
  id        Int          @id @default(autoincrement())
  codigo    String       @unique // R-0001
  activoId  Int          @map("activo_id")
  amenazaId Int          @map("amenaza_id")
  origen    OrigenRiesgo @default(GENERADO)

  // Human decisions
  madurezId     Int?    @map("madurez_id")
  frecuenciaId  Int?    @map("frecuencia_id")
  tratamientoId Int?    @map("tratamiento_id")
  estadoId      Int?    @map("estado_id")
  responsableId Int?    @map("responsable_id")
  observacion   String?
  /// An exception without a written reason cannot be stored.
  justificacion String?

  // Scope
  obsoleto   Boolean   @default(false)
  obsoletoEn DateTime? @map("obsoleto_en")
  /// Distinguishes "out of scope because the parameterisation no longer includes it"
  /// from "a person removed this threat from this asset, with a reason". Without the
  /// distinction the generator would resurrect every hand-made removal on its next run,
  /// because a pair the parameterisation still covers looks like one that came back.
  excluidoManual Boolean @default(false) @map("excluido_manual")

  // Derived — written only by the calculation service
  impacto            Decimal?  @db.Decimal(9, 4)
  riesgoPotencial    Decimal?  @map("riesgo_potencial") @db.Decimal(12, 4)
  frecuenciaResidual Decimal?  @map("frecuencia_residual") @db.Decimal(9, 4)
  riesgoResidual     Decimal?  @map("riesgo_residual") @db.Decimal(12, 4)
  calculadoEn        DateTime? @map("calculado_en")

  activo      Activo              @relation(fields: [activoId], references: [id])
  amenaza     Amenaza             @relation(fields: [amenazaId], references: [id])
  madurez     EscalaMadurez?      @relation(fields: [madurezId], references: [id])
  frecuencia  EscalaFrecuencia?   @relation(fields: [frecuenciaId], references: [id])
  tratamiento TratamientoRiesgo?  @relation(fields: [tratamientoId], references: [id])
  estado      EstadoTratamiento?  @relation(fields: [estadoId], references: [id])
  responsable CargoResponsable?   @relation(fields: [responsableId], references: [id])
  degradacion RiesgoDegradacion[]
  calculos    RiesgoCalculo[]

  @@unique([activoId, amenazaId])
  @@index([obsoleto])
  @@index([riesgoResidual])
  @@map("riesgo")
}

/// Overrides only — the baseline lives in amenaza_degradacion. Whether this table
/// should exist at all is an open question: the methodology says the limiting effect
/// belongs to the threat, so that there is one judgement per row and not two.
model RiesgoDegradacion {
  riesgoId      Int    @map("riesgo_id")
  dimensionId   Int    @map("dimension_id")
  degradacionId Int    @map("degradacion_id")
  /// Required: an exception with no reason is not an exception, it is an error.
  justificacion String

  riesgo      Riesgo            @relation(fields: [riesgoId], references: [id])
  dimension   Dimension         @relation(fields: [dimensionId], references: [id])
  degradacion EscalaDegradacion @relation(fields: [degradacionId], references: [id])

  @@id([riesgoId, dimensionId])
  @@map("riesgo_degradacion")
}

/// Freezes the exact inputs of each calculation, so a figure can always be explained.
model RiesgoCalculo {
  id                 BigInt   @id @default(autoincrement())
  riesgoId           Int      @map("riesgo_id")
  entrada            Json
  impacto            Decimal  @db.Decimal(9, 4)
  riesgoPotencial    Decimal  @map("riesgo_potencial") @db.Decimal(12, 4)
  frecuenciaResidual Decimal  @map("frecuencia_residual") @db.Decimal(9, 4)
  riesgoResidual     Decimal  @map("riesgo_residual") @db.Decimal(12, 4)
  calculadoEn        DateTime @default(now()) @map("calculado_en")

  riesgo Riesgo @relation(fields: [riesgoId], references: [id])

  @@index([riesgoId])
  @@map("riesgo_calculo")
}

/// The decision taken on a risk. A catalogue rather than an enum: membership is
/// contested between the sources and the Committee may change it.
model TratamientoRiesgo {
  id     Int     @id @default(autoincrement())
  nombre String  @unique // Mitigar, Transferir, Evitar, Aceptar y monitorear
  activo Boolean @default(true)
  orden  Int

  riesgos Riesgo[]

  @@map("tratamiento_riesgo")
}

model EstadoTratamiento {
  id     Int     @id @default(autoincrement())
  nombre String  @unique // No iniciado, En ejecución, Implementado, Cerrado
  activo Boolean @default(true)
  orden  Int

  riesgos Riesgo[]

  @@map("estado_tratamiento")
}

// ============================================================================
// Treatment plan — one row per improvement to a CONTROL, never per risk
// ============================================================================

enum TipoAccion {
  MITIGAR
  TRANSFERIR
  EVITAR
  ACEPTAR

  @@map("tipo_accion")
}

enum EstadoAccion {
  NO_INICIADA
  EN_EJECUCION
  EN_VERIFICACION
  CERRADA
  CANCELADA

  @@map("estado_accion")
}

enum VerificacionEficacia {
  PENDIENTE
  VERIFICADA_EFICAZ
  VERIFICADA_NO_EFICAZ
  NO_APLICA

  @@map("verificacion_eficacia")
}

/// The "risks it moves" counts are derived from the control's threat mappings at read
/// time, never stored, and are recomputed against the real inventory rather than
/// imported from the prototype's sample.
model AccionPlan {
  id                 Int                  @id @default(autoincrement())
  codigo             String               @unique // PT-001
  accion             String
  tipo               TipoAccion
  /// Required when tipo is MITIGAR.
  controlId          Int?                 @map("control_id")
  /// Why this action exists — the ISO 27001 6.1.3 rationale.
  origen             String
  responsableId      Int                  @map("responsable_id")
  /// The risk owner who approves. Distinct from the executor: ISO 27001 6.1.3 requires
  /// the owner's approval, so the two-person rule is structural.
  apruebaId          Int                  @map("aprueba_id")
  fechaAprobacion    DateTime?            @map("fecha_aprobacion") @db.Date
  fechaObjetivo      DateTime?            @map("fecha_objetivo") @db.Date
  recursos           String?
  estado             EstadoAccion         @default(NO_INICIADA)
  avance             Int                  @default(0)
  evidencia          String?
  fechaCierre        DateTime?            @map("fecha_cierre") @db.Date
  madurezAlcanzadaId Int?                 @map("madurez_alcanzada_id")
  madurezObjetivoId  Int?                 @map("madurez_objetivo_id")
  verificacion       VerificacionEficacia @default(PENDIENTE)
  observacion        String?

  // Conditional blocks
  instrumento             String?   @map("instrumento")
  riesgoRemanente         String?   @map("riesgo_remanente")
  justificacionAceptacion String?   @map("justificacion_aceptacion")
  fechaRevisionAceptacion DateTime? @map("fecha_revision_aceptacion") @db.Date

  activa Boolean   @default(true)
  bajaEn DateTime? @map("baja_en")

  control          Control?         @relation(fields: [controlId], references: [id])
  responsable      CargoResponsable @relation("AccionResponsable", fields: [responsableId], references: [id])
  aprueba          CargoResponsable @relation("AccionAprueba", fields: [apruebaId], references: [id])
  madurezAlcanzada EscalaMadurez?   @relation("AccionMadurezAlcanzada", fields: [madurezAlcanzadaId], references: [id])
  madurezObjetivo  EscalaMadurez?   @relation("AccionMadurezObjetivo", fields: [madurezObjetivoId], references: [id])

  @@index([controlId])
  @@map("accion_plan")
}

// ============================================================================
// Traceability
// ============================================================================

/// Append only. `registroId` is text so one table can span every entity.
/// `motivo` is present because every change records author, date, previous value and
/// REASON — the reference implementation promised it in the interface and never had
/// the column.
model Bitacora {
  id            BigInt   @id @default(autoincrement())
  tabla         String
  registroId    String   @map("registro_id")
  campo         String?
  valorAnterior String?  @map("valor_anterior")
  valorNuevo    String?  @map("valor_nuevo")
  motivo        String?
  usuario       String
  ocurridoEn    DateTime @default(now()) @map("ocurrido_en")
  /// Network origin of the operation, populated by the evidence annex flow (high, low
  /// and download of a file). Null for the rest: the application does not log an IP
  /// that it did not see.
  ip String?

  @@index([tabla, registroId])
  @@index([ocurridoEn])
  @@map("bitacora")
}

/// Maturity is re-assessed every six months and before the management review. Each cut
/// keeps the previous rating as its baseline, so progress is demonstrable rather than
/// an impression.
model LineaBase {
  id        Int      @id @default(autoincrement())
  nombre    String   @unique // "2026-Q3"
  fecha     DateTime @db.Date
  creadaPor String   @map("creada_por")
  snapshot  Json
  creadaEn  DateTime @default(now()) @map("creada_en")

  @@map("linea_base")
}

// ============================================================================
// SIG — Sistema Integrado de Gestión. Persona mirrors Azure AD; AD commands on
// name, email and existence, the SIG commands on area and position.
// ============================================================================

/// Espejo del Directorio Activo. AD manda sobre nombre, correo y existencia; el SIG manda
/// sobre área y cargo, que son atributos de gestión y no de identidad.
///
/// La identidad es el `oid` de Azure, no el correo: un cambio de apellido cambia el UPN y
/// no debe crear una persona nueva ni huerfanar sus registros.
///
/// No hay columna de rol. El rol lo dan los grupos del Directorio (lib/sgsi/permisos.ts),
/// que es la respuesta que un auditor busca cuando pregunta quién autorizó un permiso.
model Persona {
  id             Int       @id @default(autoincrement())
  /// Object id de Azure AD. Estable aunque cambie el correo.
  oid            String    @unique
  /// userPrincipalName, normalizado a minúsculas.
  correo         String    @unique
  nombre         String
  /// Baja lógica: quien sale de la organización deja de estar activa, nunca se borra,
  /// porque sus registros de realizado sostienen una auditoría.
  activa         Boolean   @default(true)
  sincronizadaEn DateTime? @map("sincronizada_en")
  areaId         Int?      @map("area_id")
  cargoId        Int?      @map("cargo_id")
  creadaEn       DateTime  @default(now()) @map("creada_en")

  area  Area?             @relation(fields: [areaId], references: [id])
  cargo CargoResponsable? @relation(fields: [cargoId], references: [id])

  obligacionesAlcance      Obligacion[] @relation("ObligacionAlcancePersona")
  obligacionesSeguimiento  Obligacion[] @relation("ObligacionSeguimiento")
  asignaciones             Asignacion[] @relation("AsignacionPersona")
  asignacionesCerradasPor  Asignacion[] @relation("AsignacionCerradaPor")
  enviosNotificacion       EnvioNotificacion[]
  hallazgosDetectados      Hallazgo[] @relation("HallazgoDetectadoPor")
  hallazgosClasificados    Hallazgo[] @relation("HallazgoClasificadoPor")
  hallazgosResponsables    Hallazgo[] @relation("HallazgoResponsable")
  hallazgosCerrados        Hallazgo[] @relation("HallazgoCerradoPor")
  correccionesHallazgo     CorreccionHallazgo[] @relation("CorreccionResponsable")
  analisisCausa            AnalisisCausa[]
  verificacionesHallazgo   VerificacionEficaciaHallazgo[]
  necesidadesResponsables NecesidadExpectativa[] @relation("NecesidadResponsable")
  requisitosLegales       RequisitoLegal[] @relation("RequisitoResponsable")
  evaluacionesCumplimiento EvaluacionCumplimiento[] @relation("EvaluacionEvaluadoPor")
  riesgosOrganizacionales RiesgoOrganizacional[] @relation("RiesgoOrgResponsable")
  materializaciones       MaterializacionRiesgo[] @relation("MaterializacionReportante")
contextosAprobados      AnalisisContexto[] @relation("ContextoAprobadoPor")
  programasAprobados      ProgramaAuditoria[] @relation("ProgramaAprobadoPor")
  programadasResponsable  AuditoriaProgramada[] @relation("ProgramadaResponsable")
  auditoriasLideradas     Auditoria[] @relation("AuditoriaLider")
  equipoAuditorias        EquipoAuditor[] @relation("EquipoAuditorPersona")
  notasAuditor            NotaAuditor[] @relation("NotaAuditorAutor")
  informesEmitidos        InformeAuditoria[] @relation("InformeEmitidoPor")
  perfilesAuditor         PerfilAuditor[] @relation("PerfilPersona")
  perfilesAprobados       PerfilAuditor[] @relation("PerfilAprobadoPor")

  @@map("persona")
}

// ============================================================================
// SIG — Motor de tareas. The numeral-8 register: what the SIG must do, who must
// do it and how often. Everything derived (vencida, cumplimiento) is computed at
// read time, never stored.
// ============================================================================

enum TipoContenido {
  CAPACITACION
  LECTURA
  VERIFICACION
  TAREA

  @@map("tipo_contenido")
}

enum AlcanceObligacion {
  PERSONA
  CARGO
  AREA
  TODOS

  @@map("alcance_obligacion")
}

enum Periodicidad {
  UNICA
  DIARIA
  SEMANAL
  MENSUAL
  TRIMESTRAL
  SEMESTRAL
  ANUAL

  @@map("periodicidad")
}

enum EstadoAsignacion {
  PENDIENTE
  REALIZADA
  NO_APLICA
  ANULADA

  @@map("estado_asignacion")
}

/// Respuesta de un ítem de verificación. Nombre distinto de `RespuestaItem` porque
/// Prisma no admite que un enum y un modelo compartan identificador.
enum ValorRespuesta {
  CUMPLE
  NO_CUMPLE
  NO_APLICA

  @@map("valor_respuesta")
}

/// Contenido reutilizable: capacitación, lectura, verificación o tarea. El código es
/// consecutivo por tipo (CAP-001, LEC-003...), generado con un contador atómico.
///
/// Bloques condicionales por tipo, siguiendo el precedente de `AccionPlan`: los campos
/// que no aplican al tipo quedan nulos y el cierre los valida.
model ContenidoSig {
  id                  Int           @id @default(autoincrement())
  codigo              String        @unique
  tipo                TipoContenido
  titulo              String
  descripcion         String
  procedimientoOrigen String?       @map("procedimiento_origen")
  /// Sube al editar un contenido que ya generó asignaciones (R10): un acuse de lectura
  /// debe seguir siendo verificable contra la versión que se leyó.
  version             Int           @default(1)
  activo              Boolean       @default(true)
  creadaEn            DateTime      @default(now()) @map("creada_en")
  actualizadoEn       DateTime      @updatedAt @map("actualizado_en")

  // LECTURA — documento referenciado, no gestionado acá.
  documentoCodigo  String? @map("documento_codigo")
  documentoNombre  String? @map("documento_nombre")
  documentoVersion String? @map("documento_version")
  documentoUrl     String? @map("documento_url")

  // CAPACITACION
  duracionHoras   Decimal? @map("duracion_horas")
  modalidad       String?
  exigeEvaluacion Boolean  @default(false) @map("exige_evaluacion")
  notaMinima      Decimal? @map("nota_minima")

  items       ItemVerificacion[]
  obligaciones Obligacion[]
  asignaciones Asignacion[]

  @@map("contenido_sig")
}

/// Ítems de un contenido VERIFICACION. La primitiva que el módulo C reutilizará.
model ItemVerificacion {
  id              Int      @id @default(autoincrement())
  contenidoId     Int      @map("contenido_id")
  orden           Int
  texto           String
  obligatorio     Boolean  @default(true)
  permiteNoAplica Boolean  @default(true) @map("permite_no_aplica")

  contenido ContenidoSig @relation(fields: [contenidoId], references: [id])
  respuestas RespuestaItem[]

  @@unique([contenidoId, orden])
  @@map("item_verificacion")
}

/// La lista maestra del numeral 8: qué contenido, a quién, cada cuánto y con qué plazo.
/// El alcance se resuelve al generar (R2), no al definir.
model Obligacion {
  id                       Int               @id @default(autoincrement())
  contenidoId              Int               @map("contenido_id")
  alcance                  AlcanceObligacion
  alcancePersonaId         Int?              @map("alcance_persona_id")
  alcanceCargoId           Int?              @map("alcance_cargo_id")
  alcanceAreaId            Int?              @map("alcance_area_id")
  periodicidad             Periodicidad
  fechaInicio              DateTime          @map("fecha_inicio") @db.Date
  plazoDias                Int               @map("plazo_dias")
  diasAviso                Int               @map("dias_aviso")
  notificar                Boolean           @default(true)
  responsableSeguimientoId Int               @map("responsable_seguimiento_id")
  activa                   Boolean           @default(true)
  creadaEn                 DateTime          @default(now()) @map("creada_en")

  contenido              ContenidoSig        @relation(fields: [contenidoId], references: [id])
  alcancePersona         Persona?            @relation("ObligacionAlcancePersona", fields: [alcancePersonaId], references: [id])
  alcanceCargo           CargoResponsable?   @relation(fields: [alcanceCargoId], references: [id])
  alcanceArea            Area?               @relation(fields: [alcanceAreaId], references: [id])
  responsableSeguimiento Persona             @relation("ObligacionSeguimiento", fields: [responsableSeguimientoId], references: [id])
  asignaciones           Asignacion[]

  @@map("obligacion")
}

/// Una instancia concreta: obligación + persona + periodo. La unique tripla es lo que
/// hace idempotente la generación: correrla dos veces no duplica nada.
model Asignacion {
  id            Int               @id @default(autoincrement())
  obligacionId  Int?              @map("obligacion_id")
  contenidoId   Int?              @map("contenido_id")
  /// Obligatorios cuando no hay contenido; ignorados cuando lo hay.
  titulo        String?
  descripcion   String?
  personaId     Int               @map("persona_id")
  /// Etiqueta legible del periodo: `2026-T3`, `2026-09`, `2026-S36`, `2026`.
  periodo       String
  fechaApertura DateTime          @map("fecha_apertura") @db.Date
  fechaLimite   DateTime          @map("fecha_limite") @db.Date
  estado        EstadoAsignacion  @default(PENDIENTE)
  fechaCierre   DateTime?         @map("fecha_cierre")
  /// Distinto de `personaId` solo en un cierre administrativo (R5).
  cerradaPor    Int?              @map("cerrada_por")
  /// Obligatorio en prórroga, anulación, no aplica y cierre administrativo.
  motivo        String?
  creadaEn      DateTime          @default(now()) @map("creada_en")

  obligacion        Obligacion?         @relation(fields: [obligacionId], references: [id])
  contenido         ContenidoSig?       @relation(fields: [contenidoId], references: [id])
  persona           Persona             @relation("AsignacionPersona", fields: [personaId], references: [id])
  cerradaPorPersona Persona?            @relation("AsignacionCerradaPor", fields: [cerradaPor], references: [id])
  registros         RegistroRealizado[]
  hallazgos         HallazgoAccion[]

  @@unique([obligacionId, personaId, periodo])
  @@index([personaId, estado])
  @@index([fechaLimite])
  @@map("asignacion")
}

/// El registro de un cierre, inmutable. 1:N con la asignación a propósito: al reabrir
/// (R8) el anterior se conserva y el nuevo cierre crea otro; el vigente es el último.
/// Quién lo registró no se repite acá: es `Asignacion.cerradaPor`.
model RegistroRealizado {
  id           Int      @id @default(autoincrement())
  asignacionId Int      @map("asignacion_id")
  fechaHora    DateTime @default(now()) @map("fecha_hora")
  nota         String?

  // LECTURA — la versión del documento en el momento del acuse (R10).
  versionLeida String? @map("version_leida")
  // CAPACITACION
  asistio      Boolean?
  calificacion Decimal?
  /// Congelado al cerrar: derivable de `notaMinima`, pero esa vive en el contenido y
  /// cambia; el registro debe seguir siendo verificable (R10).
  aprobado     Boolean?

  asignacion Asignacion       @relation(fields: [asignacionId], references: [id])
  respuestas RespuestaItem[]

  @@index([asignacionId])
  @@map("registro_realizado")
}

model RespuestaItem {
  id         Int            @id @default(autoincrement())
  registroId Int            @map("registro_id")
  itemId     Int            @map("item_id")
  respuesta  ValorRespuesta
  nota       String?

  registro RegistroRealizado @relation(fields: [registroId], references: [id])
  item     ItemVerificacion  @relation(fields: [itemId], references: [id])

  @@unique([registroId, itemId])
  @@map("respuesta_item")
}

/// Códigos consecutivos por tipo de contenido (CAP-001, LEC-003...). El mismo patrón
/// que `ContadorCodigo`: upsert atómico, porque MAX()+1 entregaría un número retirado.
model ContadorContenido {
  tipo        TipoContenido @id
  ultimoValor Int           @default(0) @map("ultimo_valor")

  @@map("contador_contenido")
}

/// El registro de cada correo del SIG. La unique tripla es lo que hace idempotente el
/// envío (N3): correr el disparo dos veces no duplica correos, y «no me llegó el aviso»
/// es una afirmación verificable (N4). `SIN_SMTP` y `FALLO` dejan rastro igual.
model EnvioNotificacion {
  id        Int            @id @default(autoincrement())
  tipo      EnvioTipo
  /// `2026-S36`, `2026-09`, o el periodo de la asignación en los avisos.
  periodo   String
  personaId Int            @map("persona_id")
  enviadoEn DateTime       @default(now()) @map("enviado_en")
  resultado EnvioResultado
  detalle   String?

  persona Persona @relation(fields: [personaId], references: [id])

  @@unique([tipo, periodo, personaId])
  @@index([tipo, periodo])
  @@map("envio_notificacion")
}

enum EnvioTipo {
  /// Aviso de una asignación nueva del periodo vigente.
  NUEVA
  /// Aviso de proximidad, según `diasAviso` de la obligación.
  PROXIMIDAD
  /// Aviso el día del vencimiento.
  VENCIMIENTO
  SEMANAL
  MENSUAL

  @@map("envio_tipo")
}

enum EnvioResultado {
  ENVIADO
  /// SMTP sin configurar: el correo no salió y queda dicho.
  SIN_SMTP
  FALLO

  @@map("envio_resultado")
}

// ============================================================================
// SIG — Mejora (ISO 9001 §10.2 · ISO/IEC 27001 §10). El estado se calcula; solo
// se almacenan las marcas de cerrado y anulado, que son actos de una persona.
// ============================================================================

enum TipoHallazgo {
  NC_MAYOR
  NC_MENOR
  OBSERVACION
  OPORTUNIDAD

  @@map("tipo_hallazgo")
}

enum OrigenHallazgo {
  AUDITORIA_INTERNA
  AUDITORIA_EXTERNA
  QUEJA
  INDICADOR
  REVISION_DIRECCION
  SGSI
  OTRO

  @@map("origen_hallazgo")
}

enum MetodoCausa {
  CINCO_PORQUES
  ISHIKAWA
  LIBRE

  @@map("metodo_causa")
}

enum PapelAccionHallazgo {
  CORRECCION
  CORRECTIVA
  MEJORA
  /// Desviación declarada: la verificación de eficacia se agenda como asignación
  /// del motor de A (decisión 3.1.2 de la spec) y necesita enlazarse al hallazgo.
  VERIFICACION

  @@map("papel_accion_hallazgo")
}

enum ResultadoEficacia {
  EFICAZ
  NO_EFICAZ

  @@map("resultado_eficacia")
}

/// El código NO lleva el tipo: reclasificar una observación reincidente a NC mayor no
/// rompe la trazabilidad. Consecutivo anual con el patrón de ContadorCodigo (B1).
model Hallazgo {
  id               Int            @id @default(autoincrement())
  codigo           String         @unique // HAL-2026-0001
  tipo             TipoHallazgo
  origen           OrigenHallazgo
  /// Referencia tipada: auditoriaId, riesgoId o controlId, codigoIndicador, o texto.
  origenReferencia String         @map("origen_referencia")
  descripcion      String
  requisitoIncumplido String      @map("requisito_incumplido")
  evidenciaObjetiva String       @map("evidencia_objetiva")
  areaId           Int            @map("area_id")
  detectadoPorId   Int            @map("detectado_por_id")
  fechaDeteccion   DateTime       @map("fecha_deteccion") @db.Date
  /// B3: hasta la clasificación el hallazgo no consume plazos.
  clasificadoPorId Int?           @map("clasificado_por_id")
  fechaClasificacion DateTime?    @map("fecha_clasificacion") @db.Date
  responsableId    Int?           @map("responsable_id")
  fechaCompromiso  DateTime?      @map("fecha_compromiso") @db.Date
  /// B10: reincidencia.
  hallazgoAnteriorId Int?         @map("hallazgo_anterior_id")
  /// Marcas almacenables; el resto del estado se calcula.
  fechaCierre      DateTime?      @map("fecha_cierre")
  cerradoPorId     Int?           @map("cerrado_por_id")
  anuladoEn        DateTime?      @map("anulado_en")
  motivoAnulacion  String?        @map("motivo_anulacion")
  creadaEn         DateTime       @default(now()) @map("creada_en")

  area             Area           @relation("HallazgoArea", fields: [areaId], references: [id])
  detectadoPor     Persona        @relation("HallazgoDetectadoPor", fields: [detectadoPorId], references: [id])
  clasificadoPor   Persona?       @relation("HallazgoClasificadoPor", fields: [clasificadoPorId], references: [id])
  responsable      Persona?       @relation("HallazgoResponsable", fields: [responsableId], references: [id])
  cerradoPor       Persona?       @relation("HallazgoCerradoPor", fields: [cerradoPorId], references: [id])
  hallazgoAnterior Hallazgo?      @relation("HallazgoReincidencia", fields: [hallazgoAnteriorId], references: [id])
  reincidentes     Hallazgo[]     @relation("HallazgoReincidencia")

  correccion  CorreccionHallazgo?
  analisis    AnalisisCausa?
  extension   ExtensionProblema?
  acciones    HallazgoAccion[]
  verificaciones VerificacionEficaciaHallazgo[]
  materializaciones MaterializacionRiesgo[]

  @@index([areaId, fechaDeteccion])
  @@map("hallazgo")
}

/// La corrección inmediata: contiene el efecto, no cierra el hallazgo.
model CorreccionHallazgo {
  id            Int      @id @default(autoincrement())
  hallazgoId    Int      @unique @map("hallazgo_id")
  descripcion   String
  responsableId Int      @map("responsable_id")
  fecha         DateTime @db.Date

  hallazgo    Hallazgo @relation(fields: [hallazgoId], references: [id])
  responsable Persona  @relation("CorreccionResponsable", fields: [responsableId], references: [id])

  @@map("correccion_hallazgo")
}

/// El método se declara y se guarda desarrollado, no como un párrafo suelto: es lo que
/// un auditor pide ver. Cinco porqués guarda los cinco pasos; Ishikawa, por categoría.
model AnalisisCausa {
  id            Int            @id @default(autoincrement())
  hallazgoId    Int            @unique @map("hallazgo_id")
  metodo        MetodoCausa
  desarrollo    Json
  causaRaiz     String         @map("causa_raiz")
  realizadoPorId Int           @map("realizado_por_id")
  fecha         DateTime       @default(now())

  hallazgo      Hallazgo       @relation(fields: [hallazgoId], references: [id])
  realizadoPor  Persona        @relation(fields: [realizadoPorId], references: [id])

  @@map("analisis_causa")
}

/// ISO 9001 §10.2.1 d: ¿el mismo problema existe en otra parte? Sin este registro la
/// NC se cierra sin haber preguntado lo que la norma obliga a preguntar.
model ExtensionProblema {
  id              Int      @id @default(autoincrement())
  hallazgoId      Int      @unique @map("hallazgo_id")
  evaluada        Boolean  @default(true)
  existeEnOtraParte Boolean @map("existe_en_otra_parte")
  analisis        String

  hallazgo        Hallazgo @relation(fields: [hallazgoId], references: [id])

  @@map("extension_problema")
}

/// Puente hallazgo ↔ asignación del motor de A. La dependencia va en un solo sentido:
/// el motor no sabe que existen los hallazgos (B12).
model HallazgoAccion {
  id           Int               @id @default(autoincrement())
  hallazgoId   Int               @map("hallazgo_id")
  asignacionId Int               @map("asignacion_id")
  papel        PapelAccionHallazgo

  hallazgo    Hallazgo          @relation(fields: [hallazgoId], references: [id])
  asignacion  Asignacion        @relation(fields: [asignacionId], references: [id])

  @@unique([hallazgoId, asignacionId])
  @@map("hallazgo_accion")
}

/// Son varias, no una: si la primera resulta no eficaz, la siguiente se agrega y el
/// historial completo queda (B6).
model VerificacionEficaciaHallazgo {
  id            Int              @id @default(autoincrement())
  hallazgoId    Int              @map("hallazgo_id")
  fecha         DateTime         @default(now())
  verificadoPorId Int            @map("verificado_por_id")
  resultado     ResultadoEficacia
  nota          String?

  hallazgo      Hallazgo         @relation(fields: [hallazgoId], references: [id])
  verificadoPor Persona          @relation(fields: [verificadoPorId], references: [id])

  @@index([hallazgoId, fecha])
  @@map("verificacion_eficacia_hallazgo")
}

/// Plazos por tipo parametrizables desde la interfaz (B7). Ningún plazo vive en el
/// código: la metodología cambió una vez y volverá a cambiar.
model PlazoPorTipoHallazgo {
  id             Int          @id @default(autoincrement())
  tipo           TipoHallazgo @unique
  diasAnalisis   Int          @map("dias_analisis")
  diasEjecucion  Int          @map("dias_ejecucion")
  diasVerificacion Int        @map("dias_verificacion")
  actualizadoEn  DateTime     @updatedAt @map("actualizado_en")

  @@map("plazo_por_tipo_hallazgo")
}

/// Consecutivo anual de hallazgos (B1).
model ContadorHallazgo {
  anio        Int  @id
  ultimoValor Int  @default(0) @map("ultimo_valor")

  @@map("contador_hallazgo")
}

// ============================================================================
// SIG — Gestión estratégica (ISO 9001 §4.1, §4.2, §6.1 · ISO 31000:2018).
// Metodologías separadas del SGSI, plataforma común. Nada calculado se almacena.
// ============================================================================

enum ClaseRiesgo {
  RIESGO
  OPORTUNIDAD

  @@map("clase_riesgo")
}

enum FuenteRiesgo {
  PROCESO
  PARTE_INTERESADA
  DOFA
  PESTEL

  @@map("fuente_riesgo")
}

enum TipoParte {
  INTERNA
  EXTERNA

  @@map("tipo_parte")
}

enum ClaseNecesidad {
  NECESIDAD
  EXPECTATIVA

  @@map("clase_necesidad")
}

enum ResultadoCumplimiento {
  CUMPLE
  PARCIAL
  NO_CUMPLE

  @@map("resultado_cumplimiento")
}

enum TipoAnalisis {
  DOFA
  PESTEL

  @@map("tipo_analisis")
}

enum EfectoEntrada {
  FAVORABLE
  ADVERSO

  @@map("efecto_entrada")
}

/// MAT-EST-02. La parte y sus necesidades/expectativas; el seguimiento es por año,
/// filas nuevas cada año, nunca columnas (decisión 3.2 de la spec).
model ParteInteresada {
  id          Int       @id @default(autoincrement())
  tipo        TipoParte
  descripcion String
  activa      Boolean   @default(true)

  necesidades NecesidadExpectativa[]

  @@map("parte_interesada")
}

model NecesidadExpectativa {
  id                      Int            @id @default(autoincrement())
  parteId                 Int            @map("parte_id")
  texto                   String
  clase                   ClaseNecesidad
  riesgoOportunidadTexto  String?        @map("riesgo_oportunidad_texto")
  esRiesgo                Boolean        @default(false) @map("es_riesgo")
  esOportunidad           Boolean        @default(false) @map("es_oportunidad")
  poder                   String
  interes                 String
  generaRequisitosSgsi    Boolean        @default(false) @map("genera_requisitos_sgsi")
  requisitoCambioClimatico Boolean       @default(false) @map("requisito_cambio_climatico")
  requiereCambioAlcanceSig Boolean       @default(false) @map("requiere_cambio_alcance_sig")
  responsableId           Int?           @map("responsable_id")

  parte       ParteInteresada        @relation(fields: [parteId], references: [id])
  responsable Persona?               @relation("NecesidadResponsable", fields: [responsableId], references: [id])
  seguimiento SeguimientoParteAnual[]

  @@map("necesidad_expectativa")
}

/// El seguimiento anual son filas, no columnas: un registro por año.
model SeguimientoParteAnual {
  id          Int      @id @default(autoincrement())
  necesidadId Int      @map("necesidad_id")
  anio        Int
  planAccion  String?  @map("plan_accion")
  seguimiento String?
  evidencia   String?

  necesidad NecesidadExpectativa @relation(fields: [necesidadId], references: [id])

  @@unique([necesidadId, anio])
  @@map("seguimiento_parte_anual")
}

/// MAT-EST-01. Se construye desde cero: la matriz real está vacía (brecha del
/// sistema, no módulo sobre datos existentes).
model RequisitoLegal {
  id                Int      @id @default(autoincrement())
  consecutivo       Int
  normatividad      String
  articulo          String?
  expedidaPor       String
  tipo              String
  objeto            String
  aplicacion        String
  sistemaGestion    String   @map("sistema_gestion")
  procesoEncargado  String?  @map("proceso_encargado")
  responsableId     Int?     @map("responsable_id")
  enlace            String?
  periodicidadRevision String @map("periodicidad_revision")
  vigente           Boolean  @default(true)
  derogadoEn        DateTime? @map("derogado_en")
  normaQueDeroga    String?  @map("norma_que_deroga")

  responsable   Persona?                  @relation("RequisitoResponsable", fields: [responsableId], references: [id])
  evaluaciones  EvaluacionCumplimiento[]

  @@map("requisito_legal")
}

model EvaluacionCumplimiento {
  id            Int                   @id @default(autoincrement())
  requisitoId   Int                   @map("requisito_id")
  fecha         DateTime              @default(now())
  resultado     ResultadoCumplimiento
  evidencia     String?
  evaluadoPorId Int                   @map("evaluado_por_id")
  hallazgoId    Int?                  @map("hallazgo_id")

  requisito RequisitoLegal @relation(fields: [requisitoId], references: [id])
  evaluadoPor Persona      @relation("EvaluacionEvaluadoPor", fields: [evaluadoPorId], references: [id])

  @@index([requisitoId, fecha])
  @@map("evaluacion_cumplimiento")
}

/// MAT-CAL-02. El código es el del Excel, inmutable (D1). La fuente es tipada (D2).
model RiesgoOrganizacional {
  id            Int          @id @default(autoincrement())
  codigo        String       @unique
  clase         ClaseRiesgo
  proceso       String
  fuente        FuenteRiesgo
  necesidadExpectativaId Int? @map("necesidad_expectativa_id")
  entradaContextoId       Int? @map("entrada_contexto_id")
  descripcion   String
  causa         String
  efecto        String
  factorId      Int          @map("factor_id")
  probabilidadId Int         @map("probabilidad_id")
  impactoId     Int          @map("impacto_id")
  responsableId Int?         @map("responsable_id")
  activo        Boolean      @default(true)
  nivelSugerido String?      @map("nivel_sugerido")

  factor        FactorRiesgo          @relation(fields: [factorId], references: [id])
  probabilidad  EscalaProbabilidad    @relation("RiesgoProbabilidad", fields: [probabilidadId], references: [id])
  impacto       EscalaImpactoRiesgo   @relation(fields: [impactoId], references: [id])
  responsable   Persona?              @relation("RiesgoOrgResponsable", fields: [responsableId], references: [id])
  controles     ControlRiesgoOrg[]
  materializaciones MaterializacionRiesgo[]
  entradaContexto EntradaContexto?    @relation(fields: [entradaContextoId], references: [id])

  @@index([clase, activo])
  @@map("riesgo_organizacional")
}

model ControlRiesgoOrg {
  id          Int    @id @default(autoincrement())
  riesgoId    Int    @map("riesgo_id")
  descripcion String
  tipoId      Int    @map("tipo_id")
  eficaciaId  Int    @map("eficacia_id")

  riesgo   RiesgoOrganizacional @relation(fields: [riesgoId], references: [id])
  tipo     TipoControlRiesgo    @relation(fields: [tipoId], references: [id])
  eficacia EficaciaControl      @relation(fields: [eficaciaId], references: [id])

  @@map("control_riesgo_org")
}

/// FOR-CAL-08. Materializar genera un hallazgo en B (D6).
model MaterializacionRiesgo {
  id                Int      @id @default(autoincrement())
  riesgoId          Int      @map("riesgo_id")
  fecha             DateTime @db.Date
  descripcionEvento String   @map("descripcion_evento")
  impactoGenerado   String   @map("impacto_generado")
  causaRaiz         String   @map("causa_raiz")
  reportanteId      Int      @map("reportante_id")
  hallazgoId        Int?     @map("hallazgo_id")

  riesgo     RiesgoOrganizacional @relation(fields: [riesgoId], references: [id])
  reportante Persona              @relation("MaterializacionReportante", fields: [reportanteId], references: [id])
  hallazgo   Hallazgo?            @relation(fields: [hallazgoId], references: [id])

  @@index([riesgoId, fecha])
  @@map("materializacion_riesgo")
}

/// DOFA y PESTEL. Una sola pareja de tablas; el catálogo de casillas cambia, no la
/// estructura. Se versiona por año y se aprueba (acta del auditor).
model AnalisisContexto {
  id              Int         @id @default(autoincrement())
  tipo            TipoAnalisis
  anio            Int
  aprobadoPorId   Int?        @map("aprobado_por_id")
  fechaAprobacion DateTime?   @map("fecha_aprobacion")
  actaReferencia  String?     @map("acta_referencia")
  vigente         Boolean     @default(true)

  aprobadoPor Persona?          @relation("ContextoAprobadoPor", fields: [aprobadoPorId], references: [id])
  entradas    EntradaContexto[]

  @@unique([tipo, anio])
  @@map("analisis_contexto")
}

model EntradaContexto {
  id          Int      @id @default(autoincrement())
  analisisId  Int      @map("analisis_id")
  casilla     String
  texto       String
  efecto      EfectoEntrada
  orden       Int

  analisis AnalisisContexto     @relation(fields: [analisisId], references: [id])
  riesgos  RiesgoOrganizacional[]

  @@unique([analisisId, orden])
  @@map("entrada_contexto")
}

// ── Catálogos parametrizables (D4) ──
model EscalaProbabilidad {
  id          Int    @id @default(autoincrement())
  valor       Int    @unique
  etiqueta    String
  descripcion String?
  color       String

  riesgos RiesgoOrganizacional[] @relation("RiesgoProbabilidad")

  @@map("escala_probabilidad")
}

model EscalaImpactoRiesgo {
  id              Int    @id @default(autoincrement())
  valor           Int    @unique
  etiqueta        String
  porcentajePatrimonio Decimal? @map("porcentaje_patrimonio") @db.Decimal(5, 2)
  referenciaCop   Decimal? @map("referencia_cop") @db.Decimal(18, 0)

  riesgos RiesgoOrganizacional[]

  @@map("escala_impacto_riesgo")
}

model EscalaImpactoOportunidad {
  id       Int    @id @default(autoincrement())
  valor    Int    @unique
  etiqueta String

  @@map("escala_impacto_oportunidad")
}

model FactorRiesgo {
  id     Int    @id @default(autoincrement())
  nombre String @unique

  riesgos RiesgoOrganizacional[]

  @@map("factor_riesgo")
}

/// El tipo de control declara qué reduce (decisión 3.1 de la spec): PROBABILIDAD,
/// IMPACTO o AMBOS. «Reactivo» es una fila, no un despliegue.
model TipoControlRiesgo {
  id          Int    @id @default(autoincrement())
  nombre      String @unique
  reduce      String
  descripcion String?

  controles ControlRiesgoOrg[]

  @@map("tipo_control_riesgo")
}

model EficaciaControl {
  id       Int    @id @default(autoincrement())
  nombre   String @unique
  valor    Decimal @db.Decimal(4, 3)
  descripcion String?

  controles ControlRiesgoOrg[]

  @@map("eficacia_control")
}

/// Rango parametrizable (0–4, 5–12, 13–25) con color y acción por clase.
model NivelRiesgo {
  id          Int    @id @default(autoincrement())
  minimo      Int    @unique
  maximo      Int
  etiqueta    String
  color       String
  accionRiesgo String @map("accion_riesgo")
  accionOportunidad String @map("accion_oportunidad")

  @@map("nivel_riesgo")
}
// ============================================================================
// SIG — Auditorías internas (ISO 9001 §9.2 · ISO/IEC 27001 §9.2). El estado se
// calcula; lo único almacenado es `emitidoEn` y `cerradaEn`, actos de una persona.
// ============================================================================

enum TipoAuditoria {
  INTERNA
  EXTERNA
  PROVEEDOR

  @@map("tipo_auditoria")
}

enum TipoNota {
  OK
  NC
  OM
  RM
  FORTALEZA

  @@map("tipo_nota")
}

enum TipoActa {
  APERTURA
  CIERRE

  @@map("tipo_acta")
}

enum VersionInforme {
  PRELIMINAR
  FINAL

  @@map("version_informe")
}

enum PapelEquipo {
  LIDER
  AUDITOR
  EN_FORMACION
  EXPERTO

  @@map("papel_equipo")
}

/// El catálogo de numerales (decisión 3.1.1: catálogo, no constante).
model NormaAuditable {
  id      Int    @id @default(autoincrement())
  codigo  String @unique
  nombre  String
  version String
  activa  Boolean @default(true)

  requisitos RequisitoNorma[]

  @@map("norma_auditable")
}

model RequisitoNorma {
  id        Int    @id @default(autoincrement())
  normaId   Int    @map("norma_id")
  numeral   String
  titulo    String
  orden     Int
  auditable Boolean @default(true)

norma NormaAuditable @relation(fields: [normaId], references: [id])
  celdas CeldaPlan[]

  @@unique([normaId, numeral])
  @@map("requisito_norma")
}

/// FOR-CAL-04: el programa anual.
model ProgramaAuditoria {
  id               Int      @id @default(autoincrement())
  anio             Int      @unique
  alcance          String
  objetivo         String
  criterios        String
  metodos          String
  aprobadoPorId    Int?     @map("aprobado_por_id")
  fechaAprobacion  DateTime? @map("fecha_aprobacion")

  aprobadoPor Persona?          @relation("ProgramaAprobadoPor", fields: [aprobadoPorId], references: [id])
  programadas AuditoriaProgramada[]

  @@map("programa_auditoria")
}

model AuditoriaProgramada {
  id               Int       @id @default(autoincrement())
  programaId       Int       @map("programa_id")
  procesoRef       String    @map("proceso_ref")
  meses            String
  tipo             TipoAuditoria @default(INTERNA)
  responsableId    Int       @map("responsable_id")
  plazoInformeDias Int       @map("plazo_informe_dias")

  programa     ProgramaAuditoria @relation(fields: [programaId], references: [id])
  responsable  Persona           @relation("ProgramadaResponsable", fields: [responsableId], references: [id])
  auditorias   Auditoria[]

  @@map("auditoria_programada")
}

/// La auditoría concreta. El estado se calcula (decisión 3.1.4).
model Auditoria {
  id            Int          @id @default(autoincrement())
  programadaId  Int?         @map("programada_id")
  tipo          TipoAuditoria
  fechaInicio   DateTime     @map("fecha_inicio") @db.Date
  fechaFin      DateTime?    @map("fecha_fin") @db.Date
  sitio         String
  objeto        String
  alcance       String
  criterios     String
  auditorLiderId Int        @map("auditor_lider_id")
  entidadAuditora String?    @map("entidad_auditora")
  emitidoEn     DateTime?    @map("emitido_en")
  cerradaEn     DateTime?    @map("cerrada_en")

  programada  AuditoriaProgramada? @relation(fields: [programadaId], references: [id])
  auditorLider Persona             @relation("AuditoriaLider", fields: [auditorLiderId], references: [id])
  equipo      EquipoAuditor[]
  celdas      CeldaPlan[]
  actas       ActaAuditoria[]
  informes    InformeAuditoria[]

  @@map("auditoria")
}

model EquipoAuditor {
  id          Int           @id @default(autoincrement())
  auditoriaId Int           @map("auditoria_id")
  personaId   Int?          @map("persona_id")
  nombreExterno String?     @map("nombre_externo")
  papel       PapelEquipo

  auditoria Auditoria @relation(fields: [auditoriaId], references: [id])
  persona   Persona?  @relation("EquipoAuditorPersona", fields: [personaId], references: [id])

  @@map("equipo_auditor")
}

/// Hoja PLAN de FOR-CAL-06: la matriz proceso × numeral.
model CeldaPlan {
  id              Int      @id @default(autoincrement())
  auditoriaId     Int      @map("auditoria_id")
  procesoRef      String   @map("proceso_ref")
  requisitoNormaId Int     @map("requisito_norma_id")
  hora            String?
  auditorId       Int?     @map("auditor_id")
  planificada     Boolean  @default(true)

  auditoria Auditoria     @relation(fields: [auditoriaId], references: [id])
  requisito RequisitoNorma @relation(fields: [requisitoNormaId], references: [id])
  notas     NotaAuditor[]

  @@unique([auditoriaId, procesoRef, requisitoNormaId])
  @@map("celda_plan")
}

/// Una nota por celda: la cobertura es medible y no hay notas huérfanas (C4).
model NotaAuditor {
  id           Int      @id @default(autoincrement())
  celdaId      Int      @map("celda_id")
  notaEvidencia String   @map("nota_evidencia")
  tipo         TipoNota
  fecha        DateTime @default(now())
  auditorId    Int      @map("auditor_id")
  hallazgoId   Int?     @map("hallazgo_id")

  celda   CeldaPlan @relation(fields: [celdaId], references: [id])
  auditor Persona   @relation("NotaAuditorAutor", fields: [auditorId], references: [id])

  @@map("nota_auditor")
}

model ActaAuditoria {
  id         Int      @id @default(autoincrement())
  auditoriaId Int     @map("auditoria_id")
  tipo       TipoActa
  fecha      DateTime @db.Date
  asistentes String
  contenido  String

  auditoria Auditoria @relation(fields: [auditoriaId], references: [id])

  @@unique([auditoriaId, tipo])
  @@map("acta_auditoria")
}

model InformeAuditoria {
  id           Int            @id @default(autoincrement())
  auditoriaId  Int            @map("auditoria_id")
  version      VersionInforme
  fechaInforme DateTime       @map("fecha_informe") @db.Date
  conclusiones String
  recomendaciones String
  emitidoPorId Int?           @map("emitido_por_id")
  emitidoEn    DateTime?      @map("emitido_en")

  auditoria  Auditoria @relation(fields: [auditoriaId], references: [id])
  emitidoPor Persona?  @relation("InformeEmitidoPor", fields: [emitidoPorId], references: [id])

  @@unique([auditoriaId, version])
  @@map("informe_auditoria")
}

/// C3: solo una persona con perfil aprobado por el Consulting Director puede ser
/// auditor líder. Los datos que PRO-CAL-04 exige para habilitar.
model PerfilAuditor {
  id                  Int      @id @default(autoincrement())
  personaId           Int?     @map("persona_id")
  nombreExterno       String?  @map("nombre_externo")
  formacion           String
  certificacion       String
  entidadCertificadora String  @map("entidad_certificadora")
  vigencia            DateTime @db.Date
  experienciaAnios    Int      @map("experiencia_anios")
  aprobadoPorId       Int?     @map("aprobado_por_id")
  aprobadoEn          DateTime? @map("aprobado_en")

  persona     Persona? @relation("PerfilPersona", fields: [personaId], references: [id])
  aprobadoPor Persona? @relation("PerfilAprobadoPor", fields: [aprobadoPorId], references: [id])

  @@map("perfil_auditor")
}